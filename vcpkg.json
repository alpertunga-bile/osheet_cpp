{
  "name": "osheet-cpp",
  "version": "0.1.0",
  "description": "Video contact sheet generator: FFmpeg decode + Skia render",
  "dependencies": [
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "png",
        "freetype"
      ]
    },
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "fontconfig"
      ],
      "platform": "linux"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avformat",
        "avcodec",
        "dav1d",
        "swscale",
        "zlib"
      ]
    },
    {
      "name": "indicators"
    },
    {
      "name": "argparse"
    }
  ],
  "builtin-baseline": "46288c8b2844070a52b15b6fe69d0e13fc97ecb4"
}
