{
  "name": "osheet-cpp",
  "version": "0.1.0",
  "description": "Video contact sheet generator: FFmpeg decode + Skia render",
  "dependencies": [
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "png",
        "freetype",
        "fontconfig"
      ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avformat",
        "avcodec",
        "dav1d",
        "swscale",
        "zlib"
      ]
    },
    {
      "name": "indicators"
    },
    {
      "name": "argparse"
    }
  ],
  "builtin-baseline": "0c2a9ace1964b818b15f7ae50ba1c42404918a7b"
}