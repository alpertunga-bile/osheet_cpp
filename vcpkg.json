{
  "name": "osheet-cpp",
  "version": "0.1.0",
  "description": "Video contact sheet generator: FFmpeg decode + Skia render",
  "dependencies": [
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "png",
        "freetype",
        "fontconfig"
      ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avformat",
        "avcodec",
        "swscale",
        "zlib"
      ]
    },
    {
      "name": "indicators"
    },
    {
      "name": "argparse"
    }
  ],
  "builtin-baseline": "13465a7b726f171350defa5368b901a52f7a6af5"
}
