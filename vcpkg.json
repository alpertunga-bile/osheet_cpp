{
  "name": "osheet-cpp",
  "version": "0.1.5",
  "description": "Video contact sheet generator: FFmpeg decode + Skia render",
  "dependencies": [
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "png",
        "freetype"
      ]
    },
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "fontconfig"
      ],
      "platform": "linux"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avformat",
        "avcodec",
        "dav1d",
        "swscale",
        "zlib"
      ]
    },
    {
      "name": "indicators"
    },
    {
      "name": "argparse"
    }
  ],
  "builtin-baseline": "4702e381dbbd9b54d3f7e1eb565cd8981c1814cd"
}