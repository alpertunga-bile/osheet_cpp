{
  "name": "osheet-cpp",
  "version": "0.1.0",
  "description": "Video contact sheet generator: FFmpeg decode + Skia render",
  "dependencies": [
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "png",
        "freetype",
        "fontconfig"
      ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avformat",
        "avcodec",
        "swscale",
        "zlib"
      ]
    },
    {
      "name": "indicators"
    },
    {
      "name": "argparse"
    }
  ],
  "builtin-baseline": "4270bf9556a461d3777207a007be0770ec77d3e5"
}
